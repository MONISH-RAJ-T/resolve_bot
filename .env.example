# Copy to .env and add your key. Never commit real keys.
POLICIES_PATH=./data/policies.md
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/shopsphere.db
APP_TODAY=2026-07-01

LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Optional tuning
# For unpaid / free-tier API keys:
# LLM_TIMEOUT=60
# REPLY_DEADLINE=65
#
# For paid API keys:
# LLM_TIMEOUT=20 or 25
# REPLY_DEADLINE=25 or 30

LLM_TIMEOUT=60
MAX_TOOL_CALLS=6
REPLY_DEADLINE=65
